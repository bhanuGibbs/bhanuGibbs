# Backend environment configuration
APP_NAME=KeelBill Ledger API
ENVIRONMENT=development
DEBUG=False

POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=quotation_db
POSTGRES_PORT=5433

# Use localhost when running the backend directly on this machine.
# URL-encode special characters in the password used in DATABASE_URL.
# For Docker, use the database service hostname instead of localhost.
DATABASE_URL=postgresql+asyncpg://postgres:replace-with-a-strong-password@localhost:5433/quotation_db
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12

CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002,http://localhost:8080,http://127.0.0.1:8080
BACKEND_PORT=8000
