# Copy this file to .env and set the required secrets before starting Compose.
APP_NAME=KeelBill Ledger API
ENVIRONMENT=development
DEBUG=False

POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=quotation_db
POSTGRES_PORT=5434

# Use the same password as POSTGRES_PASSWORD in each URL.
DATABASE_URL=postgresql+asyncpg://postgres:change-me@localhost:5434/quotation_db
DATABASE_URL_DOCKER=postgresql+asyncpg://postgres:change-me@db:5432/quotation_db

# Required: generate a unique secret with at least 32 bytes. Never use a shared/example value in production.
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRES_DAYS=7
BCRYPT_ROUNDS=12

FRONTEND_URL=http://localhost:3002
DOCKER_FRONTEND_URL=http://localhost:8080
DOCKER_CORS_ORIGINS=http://localhost:3002,http://localhost:8080
CORS_ORIGINS=http://localhost:3002,http://127.0.0.1:3002
BACKEND_PORT=8000
FRONTEND_PORT=8080

SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
